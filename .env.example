# 复制为 .env 后填写。.env 不进版本库。

# 生成模型：阿里云百炼 MaaS，千问系列（OpenAI 兼容接口）
# 真实值从自己的环境变量 API_KEY / BASE_URL 取；不要把 Key 和专属 endpoint 提交进版本库
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
# 千问 3.x 默认会先输出很长的思考过程；关掉后同一问题 11s → 2.3s
LLM_ENABLE_THINKING=false

# 决策模型：jev_style / system_one / llm_json
DECIDER_BACKEND=jev_style
DECIDER_BASE_URL=http://127.0.0.1:8765
# 只有 DECIDER_BACKEND=system_one 且连官方 Jev API 时需要
JEV_API_KEY=

# 本地模型：填模型目录路径（可以是 ModelScope / Hugging Face 下载好的目录）
EMBED_MODEL=models/bge-m3
RERANK_MODEL=models/bge-reranker-v2-m3
# reranker 后端：api=qwen3.7-text-rerank（默认，走公共 DashScope，与 LLM_API_KEY 共用）；local=本地 bge-reranker-v2-m3（显存够时用，三模型常驻会顶满 6GB）
RERANK_BACKEND=api
RERANK_API_BASE_URL=https://dashscope.aliyuncs.com
RERANK_API_MODEL=qwen3.7-text-rerank
# 下载慢时可设为 https://hf-mirror.com
HF_ENDPOINT=

# Milvus 2.6+ / 3.x（自行部署，见 README）
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=

# MySQL 8.x（自行部署，建库建表见 sql/schema.sql）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=xiaomao
MYSQL_PASSWORD=
MYSQL_DATABASE=xiaomao

# Redis（本项目 docker-compose.yml 启动）
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0

# M5 登录：JWT 签名密钥，用 python -c "import secrets;print(secrets.token_urlsafe(48))" 生成
JWT_SECRET=
# 每个用户每分钟最多提问次数
RATE_LIMIT_PER_MIN=10
